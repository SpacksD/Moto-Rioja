// server/websocket/socketManager.js
class SocketManager {
    constructor(io, redisClient) {
        this.io = io;
        this.redis = redisClient;
        this.rooms = new Map();
    }

    // Gestión de conexiones
    handleConnection(socket) {
        const userId = socket.handshake.auth.userId;
        const userType = socket.handshake.auth.userType;
        
        // Unir a rooms específicos
        socket.join(`user:${userId}`);
        
        if (userType === 'conductor') {
            socket.join('conductores');
            this.registrarConductorActivo(userId, socket.id);
        }
        
        // Event listeners
        socket.on('actualizar_ubicacion', (data) => 
            this.handleUbicacion(socket, data));
        
        socket.on('ofertar_viaje', (data) => 
            this.handleOferta(socket, data));
        
        socket.on('disconnect', () => 
            this.handleDisconnect(socket));
    }

    // Broadcast de nueva solicitud a conductores cercanos
    async broadcastNuevaSolicitud(viaje) {
        const conductoresCercanos = await this.getConductoresCercanos(
            viaje.origen_latitud, 
            viaje.origen_longitud, 
            5 // radio en km
        );
        
        conductoresCercanos.forEach(conductorId => {
            this.io.to(`user:${conductorId}`).emit('nueva_solicitud', {
                viaje_id: viaje.id,
                origen: viaje.origen_direccion,
                destino: viaje.destino_direccion,
                precio_inicial: viaje.precio_inicial_pasajero,
                distancia: viaje.distancia_km
            });
        });
    }

    // Tracking GPS durante el viaje
    async trackViaje(viajeId, conductorId, ubicacion) {
        // Guardar en Redis para histórico
        await this.redis.lpush(
            `tracking:${viajeId}`,
            JSON.stringify({
                ...ubicacion,
                timestamp: Date.now()
            })
        );
        
        // Emitir al pasajero
        const viaje = await this.getViaje(viajeId);
        this.io.to(`user:${viaje.pasajero_id}`).emit('ubicacion_conductor', {
            latitud: ubicacion.latitud,
            longitud: ubicacion.longitud,
            rumbo: ubicacion.rumbo
        });
    }
}
