### 11.2 Estrategia de Precios

```javascript
// Cálculo de comisión dinámica
function calcularComision(viaje, conductor) {
    let comisionBase = 0.15;
    
    // Ajustes por suscripción
    if (conductor.plan === 'pro') comisionBase = 0.12;
    if (conductor.plan === 'premium') comisionBase = 0.10;
    
    // Ajustes por demanda
    const hora = new Date().getHours();
    if (hora >= 7 && hora <= 9) comisionBase += 0.03; // hora pico AM
    if (hora >= 17 && hora <= 20) comisionBase += 0.03; // hora pico PM
    
    // Incentivos por zona
    if (viaje.zona === 'remota') comisionBase -= 0.02;
    
    // Límites
    comisionBase = Math.max(0.08, Math.min(0.20, comisionBase));
    
    return viaje.precio_final * comisionBase;
}
```

