-- Vista de conductores activos
CREATE VIEW conductores_activos AS
SELECT 
    c.*,
    u.nombre,
    u.apellidos,
    u.telefono,
    u.foto_perfil,
    u.calificacion_promedio
FROM conductores c
JOIN usuarios u ON c.usuario_id = u.id
WHERE c.disponible = true 
    AND c.estado_verificacion = 'aprobado'
    AND u.estado = 'activo';

-- Vista de estadísticas por conductor
CREATE VIEW estadisticas_conductor AS
SELECT 
    c.id,
    COUNT(v.id) as total_viajes,
    AVG(v.calificacion_conductor) as promedio_calificacion,
    SUM(v.precio_final_acordado) as ingresos_totales,
    SUM(v.distancia_km) as km_totales,
    COUNT(CASE WHEN v.estado = 'cancelado_conductor' THEN 1 END) as viajes_cancelados
FROM conductores c
LEFT JOIN viajes v ON c.id = v.conductor_id
WHERE v.estado = 'viaje_completado'
GROUP BY c.id;

